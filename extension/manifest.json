{
  "manifest_version": 3,
  "name": "Seizure Shield",
  "version": "0.1.0",
  "description": "Detects flashing content (WCAG 2.3.1) and hides it before it can trigger photosensitive seizures.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background/sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/loader.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/*.js", "src/detect/*.js", "src/shared/*.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Seizure Shield",
    "default_popup": "popup/popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
